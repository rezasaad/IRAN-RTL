{
  "manifest_version": 3,
  "name": "IRAN RTL",
  "version": "1.0.0",
  "description": "راست‌چین‌سازی هوشمند متون وب‌سایت‌ها بدون تغییر چیدمان صفحه، با انیمیشن‌های متنوع و میانبر دلخواه",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "IRAN RTL",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ]
}
